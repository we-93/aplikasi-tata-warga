generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// GLOBAL SETTINGS & LANDING PAGE (SaaS LEVEL)
// -----------------------------------------------------------------------------
model SiteSettings {
  id           String   @id @default(uuid())
  tenant_id    String?  @unique
  logoUrl      String?
  logoUrlDark  String?
  heroTitle    String?
  heroSubtitle String?
  heroImage    String?
  features     Json?
  pricing      Json?
  testimonials Json?
  tutorial     Json?
  faq          Json?
  howItWorks   Json?
  footerText   String?
  openaiApiKey String?
  openaiApiModel String? @default("gpt-4o-mini")
  qdrantUrl    String?
  qdrantApiKey String?
  geminiApiKey String?
  aiMasterPrompt String? @db.Text
  chatApiUrl     String? @default("https://weizerouter.web.id/v1")
  chatApiKey     String?
  chatApiModel   String? @default("wz/gemini-3.5-flash-low")
  
  docApiUrl      String? @default("https://weizerouter.web.id/v1")
  docApiKey      String?
  docApiModel    String? @default("wz/gemini-3.5-flash-low")
  
  // System & Server Settings
  faviconUrl        String?
  maintenanceMode   Boolean @default(false)
  maxUploadSizeMb   Int     @default(5)
  sessionExpiryDays Int     @default(7)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("site_settings")
}

// -----------------------------------------------------------------------------
// TENANT & MULTI-TENANCY CORE
// -----------------------------------------------------------------------------
model Tenant {
  id              String         @id @default(uuid())
  name            String         // e.g., "RT 04 / RW 08"
  slug            String         @unique
  province        String?
  city            String?
  district        String?
  village         String?
  rt              String?
  rw              String?
  address         String?    // Alamat sekretariat
  kodePos         String?    // Kode Pos
  ketuaName       String?    // Nama Ketua RT untuk cetak surat
  ketuaNik        String?    // NIK Ketua RT (opsional)
  namaRw          String?    // Nama RW
  noHpRt          String?    // Nomor HP RT
  
  // Customization
  logoUrl         String?
  signatureUrl    String?
  stampUrl        String?
  
  status          String         @default("AKTIF") // AKTIF, NONAKTIF, PENDING

  // AI Credit System
  aiChatCredits       Int      @default(30)
  aiDocCredits        Int      @default(5)
  lastCreditResetDate DateTime @default(now())

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  users           User[]
  wargas          Warga[]
  suratArsips     SuratArsip[]
  suratTemplates  SuratTemplate[]
  kasTransactions KasTransaction[]
  activityLogs    ActivityLog[]
  notulens        NotulenAi[]
  pengumumans     Pengumuman[]
  notifications   Notification[]

  @@map("tenants")
}

// -----------------------------------------------------------------------------
// AUTH & RBAC (ROLE-BASED ACCESS CONTROL)
// -----------------------------------------------------------------------------
enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  TENANT_STAFF
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  phone     String?
  password  String
  plainPassword String?
  name      String
  image     String?
  role      Role     @default(TENANT_ADMIN)
  tenantId  String?  
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  resetToken       String?
  resetTokenExpiry DateTime?

  // Relations
  logs      ActivityLog[]

  @@index([tenantId])
  @@map("users")
}

// -----------------------------------------------------------------------------
// MODULE: DATA WARGA
// -----------------------------------------------------------------------------
enum WargaStatus {
  TETAP
  KONTRAK_KOST
  PINDAH
  MENINGGAL
}

enum Gender {
  LAKI_LAKI
  PEREMPUAN
}

enum HubunganKeluarga {
  KEPALA_KELUARGA
  ISTRI
  SUAMI
  ANAK
  MENANTU
  CUCU
  ORANG_TUA
  MERTUA
  FAMILI_LAIN
  PEMBANTU
  LAINNYA
}

model Warga {
  id             String      @id @default(uuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  nik            String      @db.VarChar(16)
  noKk           String      @db.VarChar(16)
  hubunganKeluarga HubunganKeluarga @default(KEPALA_KELUARGA)
  namaLengkap    String
  namaPanggilan  String?
  tempatLahir    String?
  tanggalLahir   DateTime?   @db.Date
  jenisKelamin   Gender      @default(LAKI_LAKI)
  agama          String?
  alamat         String?     @db.Text
  statusNikah    String?
  pekerjaan      String?
  pendidikan     String?
  golonganDarah  String?
  noHp           String?
  email          String?
  
  statusWarga    WargaStatus @default(TETAP)
  tanggalMasuk   DateTime?   @default(now()) @db.Date
  
  // Dynamic fields for extra info
  meta           Json?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  suratArsips    SuratArsip[]

  @@unique([tenantId, nik])
  @@index([tenantId])
  @@map("wargas")
}

// -----------------------------------------------------------------------------
// MODULE: SURAT & ADMINISTRASI
// -----------------------------------------------------------------------------
model SuratTemplate {
  id          String   @id @default(uuid())
  tenantId    String?  // Null means global template for all tenants
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  name        String   // e.g., "Surat Keterangan Domisili"
  code        String   // e.g., "SKD"
  contentHtml String?  @db.LongText // Optional for legacy templates
  fileUrl     String?  // Path to uploaded .docx template
  
  paperSize   String   @default("A4") // "A4" or "FOLIO"
  marginTop   Float    @default(2.54) // in cm
  marginBottom Float   @default(2.54)
  marginLeft  Float    @default(2.54)
  marginRight Float    @default(2.54)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  arsips      SuratArsip[]

  @@index([tenantId])
  @@map("surat_templates")
}

model SuratArsip {
  id          String         @id @default(uuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templateId  String
  template    SuratTemplate  @relation(fields: [templateId], references: [id])
  wargaId     String?
  warga       Warga?         @relation(fields: [wargaId], references: [id], onDelete: SetNull)
  
  nomorSurat  String
  kodeSurat   String?
  pdfUrl      String?
  customData  Json?
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([tenantId])
  @@index([wargaId])
  @@map("surat_arsips")
}

// -----------------------------------------------------------------------------
// MODULE: KEUANGAN (KAS RT)
// -----------------------------------------------------------------------------
enum TransactionType {
  PEMASUKAN
  PENGELUARAN
}

model KasTransaction {
  id          String          @id @default(uuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2)
  category    String          // e.g., "Iuran Bulanan", "Sumbangan", "Perbaikan"
  description String?
  date        DateTime        @db.Date
  
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([tenantId])
  @@map("kas_transactions")
}

// -----------------------------------------------------------------------------
// MODULE: NOTULEN AI
// -----------------------------------------------------------------------------
model NotulenAi {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  judulRapat      String
  tanggalRapat    DateTime @db.Date
  peserta         String?  @db.Text  // Daftar peserta (dari transkripsi / manual)
  agendaRapat     String?  @db.Text  // Poin-poin agenda
  hasilRapat      String?  @db.Text  // Keputusan & kesepakatan
  tindakLanjut    String?  @db.Text  // Action items
  fullNotulen     String   @db.LongText // Full structured output dari AI
  
  rawTranskrip    String?  @db.LongText // Transkripsi mentah audio (opsional, disimpan untuk referensi)
  tokenUsed       Int      @default(0)  // Token yg dipakai untuk generate ini

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@map("notulen_ai")
}

// -----------------------------------------------------------------------------
// MODULE: SYSTEM & AUDIT LOGS
// -----------------------------------------------------------------------------
model ActivityLog {
  id          String   @id @default(uuid())
  tenantId    String?  
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  action      String   // e.g., "SURAT_CREATED", "WARGA_DELETED"
  description String?  @db.Text
  
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@map("activity_logs")
}

// -----------------------------------------------------------------------------
// MODULE: PENGUMUMAN
// -----------------------------------------------------------------------------
model Pengumuman {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  title       String
  content     String   @db.Text
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@map("pengumuman")
}

// -----------------------------------------------------------------------------
// MODULE: NOTIFICATIONS (IN-APP)
// -----------------------------------------------------------------------------
model Notification {
  id          String   @id @default(uuid())
  title       String
  message     String   @db.Text
  
  tenantId    String?  // Null means global notification for all tenants
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  isRead      Boolean  @default(false)
  isGlobal    Boolean  @default(false) // If true, applies to all
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@map("notifications")
}

// -----------------------------------------------------------------------------
// MODULE: KNOWLEDGE BASE (RAG)
// -----------------------------------------------------------------------------
model KnowledgeDocument {
  id        String   @id @default(uuid())
  filename  String
  fileUrl   String?
  status    String   // e.g., "PROCESSING", "READY", "FAILED"
  error     String?  @db.Text
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("knowledge_documents")
}
